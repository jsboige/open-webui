# Template de configuration pour un tenant Open WebUI
# Copier ce fichier en <tenant>.env et remplir les valeurs
#
# Architecture: chaque tenant = 1 container open-webui sur le réseau open-webui-shared
# Services partagés (dans docker-compose-infra.yaml): PostgreSQL, Tika, Redis
# Services myia (dans docker-compose-myia.yaml): Pipelines, Kokoro TTS, Whisper STT
# Config LLM/audio/image/search: clonée depuis myia via scripts/configure-tenant.py

# --- Telemetry (disabled) ---
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# --- Tenant identity ---
WEBUI_NAME='<Tenant> Open-Webui'
OPEN_WEBUI_PORT=3000
WEBUI_URL='https://<tenant>.open-webui.myia.io'

# --- Docker image ---
WEBUI_DOCKER_TAG='cuda'
USE_CUDA_DOCKER=true

# --- Defaults ---
DEFAULT_LOCALE='fr'
DEFAULT_USER_ROLE='pending'
ADMIN_EMAIL='jsboige@myia.org'
ENABLE_OLLAMA_API=false
AIOHTTP_CLIENT_TIMEOUT=6000

# --- Qdrant vector database (shared) ---
VECTOR_DB='qdrant'
QDRANT_URI='https://qdrant.myia.io:443'
QDRANT_API_KEY='CHANGEME'

# --- PostgreSQL (shared multi-tenant server in docker-compose-infra.yaml) ---
DATABASE_URL='postgresql://openwebui:CHANGEME@postgres:5432/<tenant>_db'

# --- WebSocket support (shared Redis in docker-compose-infra.yaml) ---
# Each tenant MUST use a unique DB number to avoid cross-tenant interference
# Allocation: myia=0, epf=1, epf-genai=2, ece=3, esg=4, epita=5, pauwels=6
ENABLE_WEBSOCKET_SUPPORT="true"
WEBSOCKET_MANAGER="redis"
WEBSOCKET_REDIS_URL="redis://redis:6379/<db_number>"
WEBSOCKET_REDIS_LOCK_TIMEOUT=300

# --- Open Terminal (per-tenant dedicated container) ---
# Shared API key for terminal authentication
OPEN_TERMINAL_API_KEY='CHANGEME'

# --- Channel Bot (optional, requires ENABLE_CHANNELS=true in admin settings) ---
# Bot user must be created first via admin API: POST /api/v1/auths/add
CHANNEL_BOT_EMAIL='bot@<tenant>.myia.io'
CHANNEL_BOT_PASSWORD='CHANGEME'
CHANNEL_BOT_TYPE='faq'
CHANNEL_BOT_NAME='Assistant <Tenant>'
CHANNEL_BOT_MODEL='Local.qwen3.5-35b-a3b-fast'
CHANNEL_BOT_CHANNELS=''
CHANNEL_BOT_TRIGGER=''
CHANNEL_BOT_KB_COLLECTIONS=''
CHANNEL_BOT_RAG_TOP_K=5
CHANNEL_BOT_LOG_LEVEL='INFO'
