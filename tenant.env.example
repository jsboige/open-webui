# Template de configuration pour un tenant Open WebUI
# Copier ce fichier en <tenant>.env et remplir les valeurs

# --- LLM API ---
OLLAMA_BASE_URL='http://localhost:11434'
OPENAI_API_BASE_URL=''
OPENAI_API_KEY='sk-proj-CHANGEME'

# --- Image Generation ---
AUTOMATIC1111_BASE_URL="https://stable-diffusion-webui-forge.myia.io/"

# --- Telemetry (disabled) ---
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# --- Tenant identity ---
WEBUI_NAME='<Tenant> Open-Webui'
OPEN_WEBUI_PORT=3000
WEBUI_URL='https://<tenant>.open-webui.myia.io'

# --- Docker image ---
WEBUI_DOCKER_TAG='cuda'
USE_CUDA_DOCKER=true

# --- Defaults ---
DEFAULT_LOCALE='fr'
DEFAULT_USER_ROLE='pending'
ADMIN_EMAIL='jsboige@myia.org'
ENABLE_OLLAMA_API=false
VECTOR_DB='chroma'
AIOHTTP_CLIENT_TIMEOUT=6000

# --- WebSocket (optionnel, nécessite service redis dans docker-compose) ---
# ENABLE_WEBSOCKET_SUPPORT="true"
# WEBSOCKET_MANAGER="redis"
# WEBSOCKET_REDIS_URL="redis://redis:6379/1"

# --- Ports auxiliaires (si tika/redis dans le compose, éviter les collisions) ---
# REDIS_PORT=6379
# TIKA_PORT=9998
